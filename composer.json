{
  "name": "flashpi/flashpi-laravel",
  "description": "The official Laravel package for Flashpi, the electronic invoicing API for Ecuador's SRI.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "flashpi",
    "laravel",
    "sri",
    "ecuador",
    "electronic-invoicing",
    "facturacion-electronica",
    "invoice",
    "webhooks"
  ],
  "homepage": "https://flashpi.com.ec",
  "authors": [
    {
      "name": "SIGNIADIGITAL S.A.",
      "homepage": "https://flashpi.com.ec"
    }
  ],
  "support": {
    "issues": "https://github.com/flashpi1/flashpi-laravel/issues",
    "source": "https://github.com/flashpi1/flashpi-laravel",
    "docs": "https://flashpi.com.ec/docs/sdks/"
  },
  "require": {
    "php": "^8.2",
    "flashpi/flashpi-php": "^0.1",
    "illuminate/console": "^12.71 || ^13.40",
    "illuminate/contracts": "^12.71 || ^13.40",
    "illuminate/http": "^12.71 || ^13.40",
    "illuminate/support": "^12.71 || ^13.40"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11.5.50 || ^12.5.8 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Flashpi\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flashpi\\Laravel\\Scripts\\": "scripts/",
      "Flashpi\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Flashpi\\Laravel\\FlashpiServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer check --diff",
    "cs:fix": "php-cs-fixer fix",
    "package:check": [
      "@php -r \"is_dir('build') || mkdir('build');\"",
      "git archive --format=tar --prefix=flashpi-laravel/ -o build/package.tar HEAD",
      "@php scripts/package_check.php build/package.tar"
    ],
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "analyse": "Runs PHPStan at the highest level.",
    "cs": "Checks the code style (PER-CS 2.0).",
    "cs:fix": "Fixes the code style.",
    "package:check": "Checks what Composer would install from the archive of HEAD (commit first).",
    "test": "Runs the tests."
  }
}
